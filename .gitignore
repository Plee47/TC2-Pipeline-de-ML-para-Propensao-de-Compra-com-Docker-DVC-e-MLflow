# DVC
# NOTE: .dvc/ and dvc.lock ARE versioned on purpose. Without them the
# pipeline cannot be reproduced from a clone. DVC writes its own
# .dvc/.gitignore for the local cache.
/.dvc/cache
/.dvc/tmp

# MLflow (local tracking artefacts are machine specific, never commit them)
mlruns/
mlartifacts/
mlflow.db
.mlflow

# Environment
.env
.env.local

# Data and models are tracked by DVC, which writes its own .gitignore entries
# (data/.gitignore, data/raw/.gitignore). The *.dvc pointers must stay in Git.
models/*.pkl
models/*.joblib

