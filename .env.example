# MLflow
# Local file store (default) or a tracking server, e.g. http://localhost:5000
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
EXPERIMENT_NAME=online_shoppers_intention

# Kaggle API (optional; scripts/download_dataset.py uses UCI and needs no key)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Data paths
DATA_RAW_PATH=data/raw/online_shoppers_intention.csv
DATA_PROCESSED_PATH=data/processed

# Model
# Local directory holding models/model.pkl (DVC output)
MODEL_DIR=models
# Name and alias used in the MLflow Model Registry
MODEL_NAME=online_shoppers_intention
MODEL_ALIAS=champion

# Reproducibility (params.yaml is the source of truth for the pipeline)
RANDOM_SEED=42

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
